{
  "name": "@ai-tutor/api",
  "version": "1.0.0",
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "db:seed": "tsx src/infrastructure/database/seed/index.ts",
    "sandbox:build": "tsx src/scripts/build-sandbox-template.ts",
    "sandbox:smoke": "tsx src/scripts/sandbox-smoke.ts",
    "exercises:verify": "tsx src/scripts/verify-exercises.ts",
    "user:admin": "tsx src/scripts/make-admin.ts"
  },
  "dependencies": {
    "@ai-tutor/types": "workspace:*",
    "argon2": "0.45.1",
    "bullmq": "6.3.14",
    "cookie-parser": "1.4.7",
    "drizzle-orm": "0.45.4",
    "e2b": "2.56.0",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "pg": "8.23.1",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.11",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  }
}
