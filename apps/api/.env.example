# Copy to apps/api/.env
PORT=3001
DATABASE_URL=postgres://postgres:change-me@localhost:5432/ai_tutor_db
JWT_SECRET=generate-at-least-32-random-characters
WEB_ORIGIN=http://localhost:3000
REDIS_URL=redis://localhost:6379
E2B_API_KEY=get-one-from-the-e2b-dashboard
GEMINI_API_KEY=get-one-from-ai-studio
# "true" only once billing is active on the key's project (privacy policy §5); until then hints stay frozen
GEMINI_PAID=false
