{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://${API_DOMAIN}/api/$1",
      "env": ["API_DOMAIN"],
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": { "key": "x-origin-secret" },
          "args": "${ORIGIN_SECRET}",
          "env": ["ORIGIN_SECRET"]
        }
      ]
    }
  ]
}
