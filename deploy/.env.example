# Copy to deploy/.env on the server (never commit it). Make secrets hex, e.g. `openssl rand -hex 32`:
# they are pasted into a URL and into the Caddyfile as text.

# Postgres (the API's DATABASE_URL is built from these)
POSTGRES_USER=ai_tutor
POSTGRES_PASSWORD=
POSTGRES_DB=ai_tutor

# API
JWT_SECRET=
# The web app's address, exactly as the browser sends it in Origin (no trailing slash)
WEB_ORIGIN=https://ai-tutor.example.com
E2B_API_KEY=
GEMINI_API_KEY=
# "true" only once Gemini billing is active (privacy policy §5)
GEMINI_PAID=false
BREVO_API_KEY=
# A sender verified in Brevo
MAIL_FROM=no-reply@nidanos.com

# Caddy: the API's public name (its DNS A record points at this VM), and the secret Vercel sends
# (the same value as ORIGIN_SECRET in the Vercel project)
API_DOMAIN=api.example.com
ORIGIN_SECRET=

# Backups (backup.sh): the gpg key that encrypts them; only its public half lives on this server
BACKUP_GPG_RECIPIENT=
