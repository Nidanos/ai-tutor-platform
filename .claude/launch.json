{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@ai-tutor/api", "dev"],
      "port": 3001
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@ai-tutor/web", "dev"],
      "env": { "API_URL": "http://localhost:3001" },
      "port": 3000
    }
  ]
}
